+        let mut catches_all = false;
+        collect_useless_trait_object_alternatives(pattern, &mut catches_all, &mut spans);
+    }
+    Useless::Set(spans)
+}
+
+fn collect_useless_trait_object_alternatives(
+    pattern: &Pattern,
+    catches_all: &mut bool,
+    spans: &mut HashSet<Span>,
+) {
+    if let Pattern::Alt { alts, .. } = pattern {
+        for alt in alts {
+            if *catches_all {
+                spans.insert(alt.span());
+            } else {
+                collect_useless_trait_object_alternatives(alt, catches_all, spans);
+                *catches_all |= pattern_catches_concrete_trait_object_value(alt);
+            }
+        }
+    }
