+struct IndexExpressionRebinder<'a, A> {
+    columns: &'a [ColumnRef],
+    arena: &'a A,
+}
+
+struct IndexExpressionTransplanter<'a> {
+    source_columns: &'a [ColumnRef],
+    target_columns: &'a [ColumnRef],
+}
+
+impl ExprVisitorMut<'_> for IndexExpressionTransplanter<'_> {
+    fn visit_column_ref(
+        &mut self,
+        column: &mut ColumnRef,
+        position: &mut usize,
+    ) -> Result<(), DatabaseError> {
+        let Some(new_position) = self
+            .source_columns
+            .iter()
+            .position(|source| source == column)
+        else {
+            return Err(DatabaseError::column_not_found(column.to_string()));
+        };
+        *column = self.target_columns[new_position];
+        *position = new_position;
+        Ok(())
+    }
+}
+
+impl<A: MetaArena> ExprVisitorMut<'_> for IndexExpressionRebinder<'_, A> {
+    fn visit_column_ref(
+        &mut self,
+        column: &mut ColumnRef,
+        position: &mut usize,
+    ) -> Result<(), DatabaseError> {
+        let source = self.arena.column(*column);
+        let source_id = source.id();
+        let source_table = source.table_name();
+        let Some((new_position, new_column)) =
+            self.columns
+                .iter()
+                .copied()
+                .enumerate()
+                .find(|(_, candidate)| {
+                    let candidate = self.arena.column(*candidate);
+                    candidate.id() == source_id && candidate.table_name() == source_table
+                })
+        else {
+            return Err(DatabaseError::column_not_found(source.name().to_string()));
+        };
+        *column = new_column;
+        *position = new_position;
+        Ok(())
+    }
+}
