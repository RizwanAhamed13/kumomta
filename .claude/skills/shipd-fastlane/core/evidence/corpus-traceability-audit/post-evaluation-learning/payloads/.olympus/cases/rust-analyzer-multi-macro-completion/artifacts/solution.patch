+    fake_mapped_tokens: Vec<(SyntaxToken, u8)>,
+    relative_offset: TextSize,
+    state: &mut ExpansionState,
+    direct_attribute_output: bool,
+) -> Vec<ExpansionResult> {
+    let mut mapped_tokens = mapped_tokens_with_offsets(fake_mapped_tokens)
