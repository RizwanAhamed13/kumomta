+                    new_offset,
+                    fake_mapped_token,
+                    relative_offset,
+                    state,
+                    direct_attribute_output,
+                )
+            })
+            .collect()
+    } else {
+        mapped_tokens
+            .find_map(|(fake_mapped_token, _, new_offset)| {
+                expand_maybe_stop(
+                    sema,
+                    original_file.clone(),
+                    speculative_file.clone(),
+                    new_offset,
+                    fake_mapped_token,
+                    relative_offset,
+                    state,
+                    direct_attribute_output,
