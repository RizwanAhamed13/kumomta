+
+pub fn field_default_in_typedef(span: Span) -> LisetteDiagnostic {
+    LisetteDiagnostic::error("Field default in Go declaration")
+        .with_infer_code("field_default_in_typedef")
+        .with_span_label(&span, "field defaults are not allowed in `.d.lis` files")
+        .with_help(
+            "Remove the default value; Go declaration files describe existing Go types and do \
+             not define Lisette construction behavior",
+        )
+}
