+                    *right,
+                    const_initializers,
+                    resolving,
+                )),
+                ty,
+                span,
+            },
+            Expression::Unary {
+                operator,
+                expression,
+                ty,
+                span,
+            } => Expression::Unary {
+                operator,
+                expression: Box::new(self.materialize_field_default_consts(
+                    store,
+                    *expression,
+                    const_initializers,
+                    resolving,
+                )),
+                ty,
+                span,
+            },
+            Expression::Paren {
+                expression,
+                ty,
+                span,
+            } => Expression::Paren {
+                expression: Box::new(self.materialize_field_default_consts(
+                    store,
+                    *expression,
+                    const_initializers,
+                    resolving,
+                )),
+                ty,
+                span,
+            },
+            Expression::DotAccess {
+                expression,
+                member,
+                ty,
+                span,
+                resolution,
+            } => Expression::DotAccess {
+                expression: Box::new(self.materialize_field_default_consts(
+                    store,
+                    *expression,
+                    const_initializers,
+                    resolving,
