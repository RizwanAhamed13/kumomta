+pub fn field_default_requires_simple_expression(span: Span) -> LisetteDiagnostic {
+    LisetteDiagnostic::error("Field default requires a simple expression")
+        .with_infer_code("field_default_requires_simple_expression")
+        .with_span_label(&span, "expected a constant expression")
+        .with_help("Use a literal, constant, simple expression, or payload-less enum variant")
