+#[tokio::test]
+async fn affinity_preserves_metrics_tracing_history_speculation_and_errors() {
+    let policy = Arc::new(ClusterRotatingPolicy::new());
+    let handle = ExecutionProfile::builder()
+        .load_balancing_policy(policy)
+        .speculative_execution_policy(Some(Arc::new(
+            scylla::policies::speculative_execution::SimpleSpeculativeExecutionPolicy {
+                max_retry_count: 1,
+                retry_interval: std::time::Duration::from_millis(1),
+            },
+        )))
+        .build()
+        .into_handle();
+    let (session, mut proxy) = session_with_two_nodes_and_profile(Some(handle.clone())).await;
+    for node in &mut proxy.running_nodes {
+        node.change_request_rules(Some(vec![
+            handshake_rules()[0].clone(),
+            handshake_rules()[1].clone(),
+            RequestRule(
+                Condition::RequestOpcode(RequestOpcode::Query),
+                RequestReaction::forge_response_with_delay(
+                    std::time::Duration::from_millis(20),
+                    Arc::new(|frame| {
+                        let mut response = rows_response(frame, false);
+                        response.params.flags |= 0x02;
+                        let mut body = BytesMut::new();
+                        body.extend_from_slice(uuid::Uuid::nil().as_bytes());
+                        body.extend_from_slice(&response.body);
+                        response.body = body.freeze();
+                        response
+                    }),
+                ),
+            ),
+        ]));
+    }
+
+    let history = Arc::new(scylla::observability::history::HistoryCollector::new());
+    let mut statement =
+        scylla::statement::unprepared::Statement::new("SELECT now() FROM system.local");
+    statement.set_is_idempotent(true);
+    statement.set_tracing(true);
+    statement.set_history_listener(history.clone());
+    statement.set_execution_profile_handle(Some(handle));
+    let requests_before = session.get_metrics().get_requests_manually_paged_num();
+    let (result, continuation) = session
+        .query_single_page_with_affinity(statement.clone(), (), None)
+        .await
+        .unwrap();
+    assert!(continuation.is_none());
+    assert!(result.tracing_id().is_some());
+    assert!(session.get_metrics().get_requests_manually_paged_num() >= requests_before + 1);
+    let history = history.clone_structured_history();
+    assert_eq!(history.requests.len(), 1);
+    assert_eq!(history.requests[0].speculative_fibers.len(), 1);
+
+    for node in &mut proxy.running_nodes {
+        node.change_request_rules(Some(handshake_rules()));
+    }
+    statement.set_request_timeout(Some(std::time::Duration::from_millis(100)));
+    let errors_before = session.get_metrics().get_errors_manually_paged_num();
+    assert!(
+        session
+            .query_single_page_with_affinity(statement, (), None)
+            .await
+            .is_err()
+    );
+    assert!(session.get_metrics().get_errors_manually_paged_num() >= errors_before + 1);
+    let _ = proxy.finish().await;
+}
