+async fn cancel_rule_v1(request: Result<Json<TsaRuleCancelRequest>, JsonRejection>) -> Response {
+    let Json(request) = match request {
+        Ok(request) => request,
+        Err(err) => return (StatusCode::BAD_REQUEST, err.body_text()).into_response(),
+    };
+    let action_hash = match ActionHash::parse(&request.rule_hash) {
+        Ok(action_hash) => action_hash,
+        Err(err) => return (StatusCode::BAD_REQUEST, err.to_string()).into_response(),
+    };
+
+    let Some(cancelled) = TSA_STATE
+        .get()
+        .expect("tsa_state missing")
+        .cancel_action(&action_hash)
+    else {
+        return (
+            StatusCode::NOT_FOUND,
+            format!("TSA rule {} is not active", request.rule_hash),
+        )
+            .into_response();
+    };
+
+    if let Err(err) = save_state(false).await {
+        tracing::error!("failed to persist TSA cancellation: {err:#}");
+        return (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            "failed to persist TSA cancellation",
+        )
+            .into_response();
+    }
+
+    let response = TsaRuleCancelResponse {
+        rule_hash: action_hash.to_string(),
+        config_overrides: cancelled.config_overrides,
+        ready_q_suspensions: cancelled.ready_q_suspensions,
+        scheduled_q_suspensions: cancelled.scheduled_q_suspensions,
+        scheduled_q_bounces: cancelled.scheduled_q_bounces,
+        suppress_until: cancelled.suppress_until,
+    };
+    SubscriberMgr::submit(SubscriptionItem::RuleCancellation(TsaRuleCancellation {
+        rule_hash: response.rule_hash.clone(),
+        suppress_until: response.suppress_until,
+    }));
+    Json(response).into_response()
+}
