+    /// Run `operation` only while this action is still present. Holding the
+    /// mutation lock across the operation establishes a total order with
+    /// cancellation, so a queued event cannot publish after cancellation.
+    pub fn with_active_action<F>(&self, action_hash: &ActionHash, operation: F) -> bool
+    where
+        F: FnOnce(),
+    {
+        let _guard = self.mutation_lock.lock();
+        let active = self.config_overrides.contains_key(action_hash)
+            || self.readyq_suspensions.contains_key(action_hash)
+            || self
+                .schedq_suspensions
+                .iter()
+                .any(|entry| &entry.key().action_hash == action_hash)
+            || self
+                .schedq_bounces
+                .iter()
+                .any(|entry| &entry.key().action_hash == action_hash);
+        if active {
+            operation();
+        }
+        active
+    }
