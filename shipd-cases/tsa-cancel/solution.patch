+impl TsaState {
+    fn suppression_expiry_locked(
+        &self,
+        action_hash: &ActionHash,
+        now: &DateTime<Utc>,
+    ) -> Option<DateTime<Utc>> {
+        self.cancellations
+            .get(action_hash)
+            .map(|expires| expires.clone())
+            .filter(|expires| expires > now)
+    }
+
+    pub fn cancel_action(&self, action_hash: &ActionHash) -> Option<CancellationResult> {
+        let _guard = self.mutation_lock.lock();
+        let now = Utc::now();
+        let mut suppress_until = self.suppression_expiry_locked(action_hash, &now);
+        let mut result = CancellationResult {
+            config_overrides: 0,
+            ready_q_suspensions: 0,
+            scheduled_q_suspensions: 0,
+            scheduled_q_bounces: 0,
+            suppress_until: now,
+        };
+
+        let mut extend_suppression = |expires: DateTime<Utc>| {
+            if suppress_until
+                .as_ref()
+                .map(|current| expires > *current)
+                .unwrap_or(true)
+            {
+                suppress_until = Some(expires);
+            }
+        };
+
+        if let Some((_, entry)) = self.config_overrides.remove(action_hash) {
+            if entry.expires > now {
+                result.config_overrides += 1;
+                extend_suppression(entry.expires);
+            }
+        }
+        if let Some((_, entry)) = self.readyq_suspensions.remove(action_hash) {
+            if entry.expires > now {
+                result.ready_q_suspensions += 1;
+                extend_suppression(entry.expires);
+            }
+        }
+
+        let suspension_keys: Vec<_> = self
+            .schedq_suspensions
+            .iter()
+            .filter(|entry| &entry.key().action_hash == action_hash)
+            .map(|entry| entry.key().clone())
+            .collect();
+        for key in suspension_keys {
+            if let Some((_, entry)) = self.schedq_suspensions.remove(&key) {
+                if entry.expires > now {
+                    result.scheduled_q_suspensions += 1;
+                    extend_suppression(entry.expires);
+                }
+            }
+        }
+
+        let bounce_keys: Vec<_> = self
+            .schedq_bounces
+            .iter()
+            .filter(|entry| &entry.key().action_hash == action_hash)
+            .map(|entry| entry.key().clone())
+            .collect();
+        for key in bounce_keys {
+            if let Some((_, entry)) = self.schedq_bounces.remove(&key) {
+                if entry.expires > now {
+                    result.scheduled_q_bounces += 1;
+                    extend_suppression(entry.expires);
+                }
+            }
+        }
+
+        if result.config_overrides == 0
+            && result.ready_q_suspensions == 0
+            && result.scheduled_q_suspensions == 0
+            && result.scheduled_q_bounces == 0
