     assert_eq!(partial.get("max_message_rate").unwrap(), "3/m");
     assert_eq!(partial.get("max_deliveries_per_connection").unwrap(), 1);
 
+    // Cancel the exact rule TSA reported and verify that the live Lua
+    // subscriber consumes the cancellation after processing a nonempty batch.
+    let rule_hash = reason
+        .split("rule_hash=")
+        .nth(1)
+        .and_then(|value| value.split(')').next())
+        .ok_or_else(|| anyhow::anyhow!("missing rule_hash in reason: {reason}"))?;
+    let response = reqwest::Client::new()
+        .delete(format!(
