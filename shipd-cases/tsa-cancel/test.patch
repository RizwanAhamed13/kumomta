diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..6547039
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,174 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+mode=""
+output_path=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    base|new)
+      mode="$1"
+      shift
+      ;;
+    --output_path)
+      output_path="${2:-}"
+      shift 2
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ -z "$mode" || -z "$output_path" ]]; then
+  echo "usage: ./test.sh --output_path <junit.xml> <base|new>" >&2
+  exit 2
+fi
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+case "$output_path" in
+  /*) ;;
+  *) output_path="$repo_root/$output_path" ;;
+esac
+work_root="$(mktemp -d "${TMPDIR:-/tmp}/kumomta-validation.XXXXXX")"
+trap 'rm -rf -- "$work_root"' EXIT
+tar --exclude=.git --exclude=target -C "$repo_root" -cf - . | tar -C "$work_root" -xf -
+chmod -R u+w "$work_root"
+repo_root="$work_root"
+cd "$repo_root"
+
+# Ensure the UID running this script resolves to a user; kumod-spawning
+# integration tests look themselves up via NSS and fail with
+# "couldn't resolve myself" otherwise (see crates/integration-tests/src/kumod.rs).
+# Use a UID-derived name rather than reusing "model": kumod's own
+# --user drop-privs check resolves that name back to a uid via getpwnam,
+# which returns the *first* matching /etc/passwd entry. Reusing "model"
+# would collide with the image's build-time model:x:1000:... entry and
+# resolve to uid 1000 instead of the uid actually running this script.
+if ! whoami >/dev/null 2>&1; then
+  echo "u$(id -u):x:$(id -u):$(id -g):dynamic user:${HOME:-/home/model}:/bin/bash" >> /etc/passwd
+fi
+
+mv grader_tests tests
+export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-/app/target}"
+export CARGO_NET_OFFLINE=true
+export CARGO_INCREMENTAL=0
+export RUST_BACKTRACE=1
+export CARGO_PROFILE_DEV_DEBUG=0
+export CARGO_PROFILE_TEST_DEBUG=0
+export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-5}"
+mkdir -p "$CARGO_TARGET_DIR"
+export cargo_lock="${TMPDIR:-/tmp}/kumomta-tsa-cancel-validation.lock"
+( umask 000; : > "$cargo_lock" ) 2>/dev/null || true
+mkdir -p "$(dirname "$output_path")"
+
+python3 - "$output_path" "$mode" <<'PY'
+import pathlib
+import os
+import re
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+output_path = pathlib.Path(sys.argv[1])
+mode = sys.argv[2]
+cargo_lock = os.environ["cargo_lock"]
+if mode == "base":
+    commands = [
+        (
+            "affected_packages_regression",
+            [
+                "bash", "-c",
+                "flock \"$cargo_lock\" bash -c '"
+                "rm -rf \"$CARGO_TARGET_DIR/debug/.fingerprint\"/{tsa-daemon,kumo-api-types,kumo-api-client,kumo-server-common}-*; "
+                "rm -f \"$CARGO_TARGET_DIR/debug/deps\"/{libkumo_api_types-*,libkumo_api_client-*,libkumo_server_common-*,tsa_daemon-*} \"$CARGO_TARGET_DIR/debug/tsa-daemon\"; "
+                "cargo build --offline --locked -p tsa-daemon'",
+            ],
+        ),
+    ]
+else:
+    commands = [
+        (
+            "public_daemon_lifecycle",
+            [
+                "bash",
+                "-c",
+                "flock \"$cargo_lock\" bash -c '"
+                "rm -rf \"$CARGO_TARGET_DIR/debug/.fingerprint\"/{tsa-daemon,kumo-api-types,kumo-api-client,kumo-server-common}-*; "
+                "rm -f \"$CARGO_TARGET_DIR/debug/deps\"/{libkumo_api_types-*,libkumo_api_client-*,libkumo_server_common-*,tsa_daemon-*} \"$CARGO_TARGET_DIR/debug/tsa-daemon\"; "
+                "cargo build --offline --locked -p tsa-daemon && "
+                "python3 tests/test_public_daemon.py'",
+            ],
+        ),
+        (
+            "lua_subscriber_cancellation",
+            [
+                "bash",
+                "-c",
+                "flock \"$cargo_lock\" bash -c '"
+                "cargo build --offline --locked -p kumod -p tsa-daemon -p kcli && "
+                "cargo test --offline --locked -p integration-tests "
+                "test::tsa_basic_automation::tsa_basic_automation -- --exact --nocapture'",
+            ],
+        ),
+        (
+            "trusted_listener_acl",
+            ["python3", "tests/test_exposure.py"],
+        ),
+        (
+            "openapi_snapshot",
+            ["python3", "tests/test_openapi.py"],
+        ),
+    ]
+
+
+def xml_safe(text):
+    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
+    return "".join(ch for ch in text if ch in "\t\n\r" or ord(ch) >= 0x20)
+
+
+suite = ET.Element("testsuite", name=f"kumomta_tsa_cancel_{mode}")
+failures = 0
+total_time = 0.0
+for name, command in commands:
+    started = time.monotonic()
+    result = subprocess.run(
+        command,
+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+    )
+    elapsed = time.monotonic() - started
+    total_time += elapsed
+    log = xml_safe(result.stdout)
+    print(f"$ {' '.join(command)}")
+    print(log, end="")
+
+    case = ET.SubElement(
+        suite,
+        "testcase",
+        classname=f"kumomta.tsa_cancel.{mode}",
+        name=name,
+        time=f"{elapsed:.3f}",
+    )
+    ET.SubElement(case, "system-out").text = log
+    if result.returncode != 0:
+        failures += 1
+        failure = ET.SubElement(
+            case,
+            "failure",
+            message=f"command exited with status {result.returncode}",
+        )
+        failure.text = log
+
+suite.set("tests", str(len(commands)))
+suite.set("failures", str(failures))
+suite.set("errors", "0")
+suite.set("skipped", "0")
+suite.set("time", f"{total_time:.3f}")
+output_path.write_bytes(
+    ET.tostring(suite, encoding="utf-8", xml_declaration=True)
+)
+sys.exit(1 if failures else 0)
+PY
