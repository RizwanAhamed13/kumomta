+        .send()
+        .await?;
+    anyhow::ensure!(
+        response.status().is_success(),
+        "cancel_rule_v1 failed: {} {}",
+        response.status(),
+        response.text().await?
+    );
+
+    let cancelled = tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            if get_suspensions(&daemon).await?.is_empty() {
+                return Ok::<_, anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await;
+    anyhow::ensure!(cancelled.is_ok(), "kumod did not consume rule cancellation");
